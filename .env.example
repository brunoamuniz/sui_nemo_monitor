# SUI Monitor Configuration
# Copy this file to .env and fill in your values

# Sui RPC Configuration
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Protocol Configurations
# NEMO Protocol
NEMO_PACKAGE_ID=0x0f286ad004ea93ea6ad3a953b5d4f3c7306378b0dcc354c3f4ebb1d506d3b47f
NEMO_MODULES=market,py,yield_factory,sy
NEMO_ALERT_THRESHOLD_USD=10000

# SCALLOP Protocol
SCALLOP_PACKAGE_ID=0xee1ff66985a76b2c0170935fb29144b4007827ed2c4f3d6a1189578afb92bcdd
SCALLOP_MODULES=scallop
SCALLOP_ALERT_THRESHOLD_USD=10000

# Monitoring Settings
CHECK_INTERVAL_MINUTES=5
LARGE_TRANSFER_THRESHOLD_USD=10000
MAX_TRANSACTIONS_PER_CHECK=50

# Cache Settings
CACHE_ENABLED=true
MAX_TRANSACTIONS_PER_PROTOCOL=50
CACHE_TTL_HOURS=24
CACHE_DIRECTORY=./cache

# Telegram Configuration
# Get your API credentials from https://my.telegram.org/
TELEGRAM_ENABLED=true
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=user_session
TELEGRAM_CHAT_ID=your_chat_id_here
